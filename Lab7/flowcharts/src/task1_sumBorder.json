[
  { "name": "sumOnShadedBorder", "main": false, "block": { "kind": "block", "stmts": [
    { "kind": "io", "text": "Ввести матрицю a, вимірність m" },
    { "kind": "process", "text": "Сума елементів межі sum = 0" },
    { "kind": "process", "text": "Кількість елементів межі count = 0" },
    { "kind": "for", "cond": "i := 0, m − 1", "body": { "stmts": [
