          "then": { "stmts": [
            { "kind": "process", "text": "Збільшити sum на елемент рядка i, стовпця j" },
            { "kind": "process", "text": "Збільшити count на 1" }
          ] },
          "else": { "stmts": [] } }
      ] } }
    ] } },
    { "kind": "terminal", "text": "Повернути sum" }
  ] } }
]
